
instrument {
    name = "QMS 3S3C PREDICTOR LONG PRO",
    short_name = "QMS PREDICTOR LONG",
    icon = "indicators:MACD",
    overlay = false
}

-- =========================================
-- 1. CONFIGURACOES
-- =========================================

input_group {
    "ANTECIPACAO",

    corpo_minimo = input {
        default = 40,
        type = input.integer,
        min = 10,
        max = 90
    },

    exigir_progressao = input {
        default = true,
        type = input.boolean
    }
}

input_group {
    "MOMENTUM E ACELERACAO",

    periodo_momentum = input {
        default = 10,
        type = input.integer,
        min = 2,
        max = 50
    },

    suavizacao = input {
        default = 3,
        type = input.integer,
        min = 1,
        max = 20
    },

    exigir_aceleracao = input {
        default = true,
        type = input.boolean
    }
}

input_group {
    "PROJECAO FUTURA",

    multiplicador_1 = input {
        default = 150,
        type = input.integer,
        min = 100,
        max = 300
    },

    multiplicador_2 = input {
        default = 200,
        type = input.integer,
        min = 100,
        max = 400
    },

    multiplicador_3 = input {
        default = 300,
        type = input.integer,
        min = 100,
        max = 500
    }
}

input_group {
    "CORES",

    cor_compra = input {
        default = "#00C853",
        type = input.color
    },

    cor_venda = input {
        default = "#FF3030",
        type = input.color
    },

    cor_antecipacao = input {
        default = "#00BFFF",
        type = input.color
    },

    cor_projecao = input {
        default = "#FFD700",
        type = input.color
    },

    cor_neutra = input {
        default = "#808080",
        type = input.color
    }
}

-- =========================================
-- 2. FORCA DOS CANDLES
-- =========================================

amplitude_0 = high - low
amplitude_1 = high[1] - low[1]
amplitude_2 = high[2] - low[2]

corpo_0 = abs(close - open)
corpo_1 = abs(close[1] - open[1])
corpo_2 = abs(close[2] - open[2])

forca_0 =
corpo_0 / (amplitude_0 + 0.0000001) * 100

forca_1 =
corpo_1 / (amplitude_1 + 0.0000001) * 100

forca_2 =
corpo_2 / (amplitude_2 + 0.0000001) * 100

forte_0 = forca_0 >= corpo_minimo
forte_1 = forca_1 >= corpo_minimo
forte_2 = forca_2 >= corpo_minimo

-- =========================================
-- 3. MOMENTUM
-- =========================================

momentum_bruto =
(close / (close[periodo_momentum] + 0.0000001) - 1) * 100

momentum =
ema(momentum_bruto, suavizacao)

aceleracao =
momentum[1] - momentum[2]

aceleracao_anterior =
momentum[2] - momentum[3]

-- =========================================
-- 4. PRESSAO COMPRADORA E VENDEDORA
-- =========================================

pressao_compra =
close[1] > open[1] and
close[2] > open[2]

pressao_venda =
close[1] < open[1] and
close[2] < open[2]

progressao_alta =
close[1] > close[2]

progressao_baixa =
close[1] < close[2]

-- =========================================
-- 5. ANTECIPACAO DE ALTA
-- =========================================

antecipacao_compra =
pressao_compra and
forte_1 and
forte_2 and
(
    not exigir_progressao or
    progressao_alta
) and
momentum[1] > 0 and
(
    not exigir_aceleracao or
    aceleracao > 0
)

-- =========================================
-- 6. ANTECIPACAO DE BAIXA
-- =========================================

antecipacao_venda =
pressao_venda and
forte_1 and
forte_2 and
(
    not exigir_progressao or
    progressao_baixa
) and
momentum[1] < 0 and
(
    not exigir_aceleracao or
    aceleracao < 0
)

-- =========================================
-- 7. CONFIRMACAO 3 SOLDADOS
-- =========================================

soldado_1 = close[2] > open[2]
soldado_2 = close[1] > open[1]
soldado_3 = close > open

tres_soldados =
soldado_1 and
soldado_2 and
soldado_3 and
forte_0 and
forte_1 and
forte_2 and
close > close[1] and
close[1] > close[2]

sinal_compra =
tres_soldados and
momentum > 0

-- =========================================
-- 8. CONFIRMACAO 3 CORVOS
-- =========================================

corvo_1 = close[2] < open[2]
corvo_2 = close[1] < open[1]
corvo_3 = close < open

tres_corvos =
corvo_1 and
corvo_2 and
corvo_3 and
forte_0 and
forte_1 and
forte_2 and
close < close[1] and
close[1] < close[2]

sinal_venda =
tres_corvos and
momentum < 0

-- =========================================
-- 9. ACELERACAO PROJETADA
-- =========================================

fator_1 = multiplicador_1 / 100
fator_2 = multiplicador_2 / 100
fator_3 = multiplicador_3 / 100

previsao_alta =
momentum[1] + aceleracao * fator_1

previsao_alta_2 =
momentum[1] + aceleracao * fator_2

previsao_alta_3 =
momentum[1] + aceleracao * fator_3

previsao_baixa =
momentum[1] + aceleracao * fator_1

previsao_baixa_2 =
momentum[1] + aceleracao * fator_2

previsao_baixa_3 =
momentum[1] + aceleracao * fator_3

-- =========================================
-- 10. ATIVACAO DAS PROJECOES
-- =========================================

modo_compra =
antecipacao_compra or sinal_compra

modo_venda =
antecipacao_venda or sinal_venda

projecao_compra_1 =
modo_compra and previsao_alta or 0

projecao_compra_2 =
modo_compra and previsao_alta_2 or 0

projecao_compra_3 =
modo_compra and previsao_alta_3 or 0

projecao_venda_1 =
modo_venda and previsao_baixa or 0

projecao_venda_2 =
modo_venda and previsao_baixa_2 or 0

projecao_venda_3 =
modo_venda and previsao_baixa_3 or 0

-- =========================================
-- 11. LINHA DE MOMENTUM
-- =========================================

cor_linha = cor_neutra

if momentum > 0 then
    cor_linha = cor_compra
end

if momentum < 0 then
    cor_linha = cor_venda
end

plot(
    momentum,
    "MOMENTUM ATUAL",
    cor_linha,
    2
)

plot(
    0,
    "LINHA ZERO",
    cor_neutra,
    1
)

-- =========================================
-- 12. PROJECAO DE ALTA
-- =========================================

plot(
    projecao_compra_1,
    "ALTA PROJECAO 1",
    cor_compra,
    1
)

plot(
    projecao_compra_2,
    "ALTA PROJECAO 2",
    cor_compra,
    2
)

plot(
    projecao_compra_3,
    "ALTA PROJECAO 3",
    cor_projecao,
    3
)

-- =========================================
-- 13. PROJECAO DE BAIXA
-- =========================================

plot(
    projecao_venda_1,
    "BAIXA PROJECAO 1",
    cor_venda,
    1
)

plot(
    projecao_venda_2,
    "BAIXA PROJECAO 2",
    cor_venda,
    2
)

plot(
    projecao_venda_3,
    "BAIXA PROJECAO 3",
    cor_projecao,
    3
)

-- =========================================
-- 14. SINAIS DE ANTECIPACAO
-- =========================================

plot_shape(
    antecipacao_compra,
    "ANTECIPACAO DE ALTA",
    shape_style.triangleup,
    shape_size.large,
    cor_antecipacao,
    shape_location.bottom
)

plot_shape(
    antecipacao_venda,
    "ANTECIPACAO DE BAIXA",
    shape_style.triangledown,
    shape_size.large,
    cor_antecipacao,
    shape_location.top
)

-- =========================================
-- 15. SINAIS DE CONFIRMACAO
-- =========================================

plot_shape(
    sinal_compra,
    "ALTA CONFIRMADA 3 SOLDADOS",
    shape_style.triangleup,
    shape_size.large,
    cor_compra,
    shape_location.bottom
)

plot_shape(
    sinal_venda,
    "BAIXA CONFIRMADA 3 CORVOS",
    shape_style.triangledown,
    shape_size.large,
    cor_venda,
    shape_location.top
)
